@startuml 01_use_case
left to right direction
skinparam packageStyle rectangle

actor User as user

rectangle "Signly Mobile App" {
  usecase "Login" as UC_Login
  usecase "Recognize ASL" as UC_Recognize
  usecase "Text to Sign" as UC_Text
  usecase "Voice to Sign" as UC_Voice
  usecase "Letters & Numbers" as UC_Letters
  usecase "Lips Detection" as UC_Lips
  usecase "Dictionary" as UC_Dictionary
  usecase "Profile" as UC_Profile

  usecase "Use Camera" as UC_Camera
  usecase "Use Microphone" as UC_Mic
  usecase "Validate Credentials" as UC_Validate
  usecase "Show Prediction Confidence" as UC_Confidence
  usecase "Match Target Letter" as UC_MatchLetter
  usecase "Spell by Letters" as UC_SpellLetters
}

user --> UC_Login
user --> UC_Recognize
user --> UC_Text
user --> UC_Voice
user --> UC_Letters
user --> UC_Lips
user --> UC_Dictionary
user --> UC_Profile

' Include (required sub-use-cases)
UC_Recognize ..> UC_Camera : <<include>>
UC_Lips ..> UC_Camera : <<include>>
UC_Voice ..> UC_Mic : <<include>>
UC_Login ..> UC_Validate : <<include>>

' Extend (optional extensions)
UC_Recognize <.. UC_Confidence : <<extend>>
UC_Lips <.. UC_MatchLetter : <<extend>>
UC_Text <.. UC_SpellLetters : <<extend>>

note right of UC_Recognize
  Real-time hand sign
  recognition from camera
end note

note right of UC_Lips
  Detect lip movement
  and viseme letters (A–E)
end note

@enduml
